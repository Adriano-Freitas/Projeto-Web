# Porta da aplicacao (padrao 8000)
PORT=8000

# Configuracoes do Banco de Dados PostgreSQL
DB_HOST=seu-host-postgresql.neon.tech
DB_PORT=5432
DB_NAME=assistencia
DB_USER=seu_usuario
DB_PASS=sua_senha

# Configuracoes de E-mail (SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu_login_smtp
SMTP_PASS=sua_chave_smtp
SMTP_FROM_EMAIL=seu_email_verificado@dominio.com
SMTP_FROM_NAME="FixIt Assistencia"
SMTP_TO_ADMIN=seu_email_admin@dominio.com
